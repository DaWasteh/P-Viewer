{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "P-Viewer",
  "version": "0.1.3",
  "identifier": "io.github.dawasteh.pviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "P-Viewer",
        "width": 1280,
        "height": 820,
        "minWidth": 840,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; media-src 'self' data: blob:; object-src 'none'; frame-src 'self'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/file-associations.nsh"
      }
    },
    "resources": [
      "../THIRD_PARTY_NOTICES.md"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mkdn",
          "mdwn"
        ],
        "name": "PViewer.Markdown",
        "description": "Markdown-Dokument",
        "role": "Editor",
        "mimeType": "text/markdown",
        "rank": "Alternate",
        "contentTypes": [
          "net.daringfireball.markdown"
        ]
      },
      {
        "ext": [
          "mdx"
        ],
        "name": "PViewer.Mdx",
        "description": "MDX-Dokument",
        "role": "Editor",
        "mimeType": "text/mdx",
        "rank": "Alternate",
        "contentTypes": [
          "public.source-code"
        ]
      },
      {
        "ext": [
          "rmd",
          "qmd"
        ],
        "name": "PViewer.RMarkdown",
        "description": "R-Markdown- oder Quarto-Dokument",
        "role": "Editor",
        "mimeType": "text/x-rmarkdown",
        "rank": "Alternate",
        "contentTypes": [
          "net.daringfireball.markdown"
        ]
      },
      {
        "ext": [
          "json",
          "jsonc",
          "json5",
          "jsonl",
          "ndjson",
          "map",
          "har",
          "avsc",
          "arb",
          "sarif",
          "code-workspace",
          "code-snippets"
        ],
        "name": "PViewer.Json",
        "description": "JSON-Dokument",
        "role": "Editor",
        "mimeType": "application/json",
        "rank": "Alternate",
        "contentTypes": [
          "public.json"
        ]
      },
      {
