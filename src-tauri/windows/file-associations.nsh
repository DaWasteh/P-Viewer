  !insertmacro PVIEWER_REMOVE_AUTO_FILE_ICONS
  DeleteRegValue SHCTX "Software\RegisteredApplications" "P-Viewer"
  DeleteRegKey SHCTX "Software\P-Viewer\Capabilities"
  DeleteRegKey /ifempty SHCTX "Software\P-Viewer"
  DeleteRegKey /ifempty HKCU "Software\P-Viewer"
  DeleteRegKey SHCTX "Software\Classes\Applications\${MAINBINARYNAME}.exe"
  System::Call "shell32::SHChangeNotify(i,i,i,i) (0x08000000, 0x1000, 0, 0)"
!macroend
